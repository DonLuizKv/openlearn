{
  "expo": {
    "name": "OpenLearn",
    "slug": "openlearn",
    "scheme": "openlearn",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/openlearn-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openlearn.study"
    },
    "android": {
      "package": "com.openlearn.study",
      "adaptiveIcon": {
        "backgroundColor": "#2C6651",
        "foregroundImage": "./assets/openlearn-adaptive.png",
        "monochromeImage": "./assets/openlearn-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/openlearn-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
